---
import { SITE } from "@/siteConfig";
import ThemeToggle from "@/components/ThemeToggle.astro";

const year = new Date().getFullYear();
---

<footer
  class="mx-auto flex w-full flex-col items-start gap-6 pt-16 pb-24 sm:flex-row sm:items-center sm:justify-between sm:gap-8"
>
  <ThemeToggle />
  <span class="prose dark:prose-invert prose-neutral mt-2"
    >Made with ❤️ in Oakland, CA 
    <br/>
    Powered by <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">Astro</a> and <a href="https://tailwindcss.com/" target="_blank" rel="noopener noreferrer">Tailwind CSS</a>
    <br/>
    {year} by {SITE.author}</span
  >
</footer>
