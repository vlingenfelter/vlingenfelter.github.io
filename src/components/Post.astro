---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "@/lib/util";
import { Image } from "astro:assets";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
---


<div class="card block p-0 rounded-sm shadow-xs">
    <a href={`/dev_website/posts/${post.id}`}>
      {
        post.data.image && (
          <Image
            src={post.data.image}
            alt={post.data.imageAlt || ""}
            class="mb-12 h-auto w-full rounded-sm"
            draggable="false"
            loading="eager"
          />
        )
      }
    </a>
    <div class="px-6 pb-6">
    <a href={`/dev_website/posts/${post.id}`}>
        <h5 class="font-display mb-2 text-2xl font-semibold tracking-tight text-heading">
          {post.data.title}
        </h5>
    </a>
    <p class="text-muted-text dark:text-dark-muted-text mb-4">
      {post.data.description}
    </p>
    <a href={`/dev_website/posts/${post.id}`} class="button inline-flex items-center text-body box-border border border-default-medium shadow-xs font-medium leading-5 rounded-sm text-sm px-4 py-2.5">
        Read more
    </a>
    </div>
</div>

